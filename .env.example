# Credenciales dedicadas a NØBØĐ¥ CEO — nunca reutilizar claves de otros
# proyectos del árbol conversa/. Copiar a .env y llenar; .env nunca se
# commitea (ver .gitignore).

# Motor de razonamiento del CEO
ANTHROPIC_API_KEY=

# Telegram — bot nuevo vía @BotFather, restringido al chat_id del Founder
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=

# YouTube Data API v3 + YouTube Analytics API — proyecto de Google Cloud
# nuevo, cliente OAuth tipo "Desktop app", scopes de solo lectura
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Spotify Web API — app nueva en el Developer Dashboard. Nota: esto NO
# expone streams ni regalías (eso vive en Spotify for Artists, sin API
# pública) — ver docs de arquitectura para el alcance real de v0.1.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# DistroKid no tiene API oficial — ver integrations/distrokid/README.md.
# Los exports (results.csv) se importan manualmente vía
# agents.capabilities.royalties_ingest, no hay credenciales que llenar acá.

# Opcional — cada cuántas horas se genera y envía el Board Report semanal
# (Telegram + correo). Default: 168 (7 días).
NOBODY_WEEKLY_REPORT_INTERVAL_HOURS=
